// Modelo de datos real de Plei Marketplace Intelligence.
//
// Mapeo de nombres: el CSV fuente (export de Hex) usa "Division" y "Region"
// al revés de como el negocio los llama. Acá los modelamos con el nombre
// que tiene sentido de negocio, y dejamos la referencia al CSV en el comentario:
//
//   Region    (East / West)              <- columna CSV "Division"
//   Market    (South Florida, Orlando..) <- columna CSV "Region"
//   Facility  (una cancha/instalación)   <- columna CSV "Location"
//   Game      (un partido/evento)        <- cada fila del CSV

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Region {
  id      String   @id @default(cuid())
  name    String   @unique // "East" | "West"
  markets Market[]

  @@map("regions")
}

model Market {
  id         String     @id @default(cuid())
  name       String     // "South Florida", "Orlando", "DMV | Baltimore", etc.
  regionId   String
  region     Region     @relation(fields: [regionId], references: [id])
  facilities Facility[]

  @@unique([name, regionId])
  @@map("markets")
}

model Facility {
  id       String @id @default(cuid())
  name     String // columna CSV "Location"
  marketId String
  market   Market @relation(fields: [marketId], references: [id])
  games    Game[]

  @@unique([name, marketId])
  @@index([marketId])
  @@map("facilities")
}

enum GameStatus {
  CONFIRMED
  CANCELLED
}

// Categoría normalizada de motivo de cancelación. El CSV trae texto libre
// con 291 variantes distintas (con mayúsculas/espacios inconsistentes);
// esto es la versión limpia que usamos para generar insights confiables.
enum CancellationCategory {
  NOT_ENOUGH_PLAYERS
  FACILITY_UNAVAILABLE
  WEATHER
  MAINTENANCE
  HOLIDAY
  OTHER
}

model Game {
  id                    Int                   @id // "Game ID" del CSV, ya es único
  facilityId            String
  facility              Facility              @relation(fields: [facilityId], references: [id])
  organizer             String                // "Plei" | "2026 Summer of Soccer" | "Plei Video"
  date                  DateTime              @db.Date
  time                  String                // hora de inicio, formato "HH:MM"
  dayOfWeek             String
  minPlayers            Int
  maxPlayers            Int
  gameSize              String?               // "Game Size" del CSV — dato directo (ej "7v7"), reemplaza la inferencia por Max Players
  fieldType             String?               // extraído de "Field" — solo cuando el dato tiene especificidad real (tipo o nombre), null si es solo un identificador (ej "Field #1")
  finalPlayers          Int
  waitlistPlayers       Int
  droppedPlayers        Int
  status                GameStatus
  playersMissing        Int?
  cancellationReasonRaw String?               // texto original del CSV, para auditoría
  cancellationCategory  CancellationCategory?
  confirmationLeadTime  Float?                // horas entre confirmación y el partido
  eventRevenue          Float?
  gamePrice             Float?
  revenuePerPlayer      Float?
  ratingCount           Int?
  averageRating         Float?
  createdAt             DateTime              @default(now())

  @@index([facilityId])
  @@index([date])
  @@index([status])
  // Compuestos: la mayoría de las consultas reales combinan estas columnas
  // juntas (rango de fecha + status, o facility + status/fecha) desde que
  // migramos a groupBy/aggregate — un índice compuesto sirve para ese patrón
  // completo, no solo para filtrar por una columna sola.
  @@index([date, status])
  @@index([facilityId, status])
  @@index([facilityId, date])
  @@map("games")
}

// Rol de cuenta. Simple a propósito: hoy solo distingue quién puede
// administrar usuarios (ADMIN) del resto (MEMBER). Es el punto de extensión
// para permisos más finos (por región/market, etc.) cuando haya un caso de
// uso real que lo pida — no se construye antes de tiempo.
enum Role {
  ADMIN
  MEMBER
}

// Cuenta de la app. NextAuth sigue en JWT puro (sin adapter/DB sessions) —
// esta tabla no reemplaza esa sesión, es el registro de negocio asociado
// a cada email. Se crea/actualiza sola en el callback signIn (ver
// app/lib/auth.ts): no hay alta manual, el primer login de un email
// autorizado (dominio de Google Workspace) ya crea la fila. El rol inicial
// sale de ADMIN_EMAILS (variable de entorno, solo importa en el primer
// login de cada cuenta); a partir de ahí, los cambios de rol se hacen desde
// /admin/users, no editando esa variable.
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  image       String?
  role        Role      @default(MEMBER)
  // Reemplaza a la vieja UserPreference: mismo dato (idioma elegido), ahora
  // en la misma fila que el resto de la cuenta en vez de una tabla aparte
  // keyed por el mismo email.
  locale      String    @default("es")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@map("users")
}
