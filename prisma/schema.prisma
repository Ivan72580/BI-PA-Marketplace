// Modelo de datos real de Plei Marketplace Intelligence.
//
// Mapeo de nombres: el CSV fuente (export de Hex) usa "Division" y "Region"
// al revés de como el negocio los llama. Acá los modelamos con el nombre
// que tiene sentido de negocio, y dejamos la referencia al CSV en el comentario:
//
//   Region    (East / West)              <- columna CSV "Division"
//   Market    (South Florida, Orlando..) <- columna CSV "Region"
//   Facility  (una cancha/instalación)   <- columna CSV "Location"
//   Game      (un partido/evento)        <- cada fila del CSV

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Region {
  id      String   @id @default(cuid())
  name    String   @unique // "East" | "West"
  markets Market[]

  @@map("regions")
}

model Market {
  id         String     @id @default(cuid())
  name       String     // "South Florida", "Orlando", "DMV | Baltimore", etc.
  regionId   String
  region     Region     @relation(fields: [regionId], references: [id])
  facilities Facility[]

  @@unique([name, regionId])
  @@map("markets")
}

model Facility {
  id       String @id @default(cuid())
  name     String // columna CSV "Location"
  marketId String
  market   Market @relation(fields: [marketId], references: [id])
  games    Game[]
  // Datos maestros manuales (perfil + relación comercial) — ver
  // FacilityProfile. Opcional porque no todos los facilities lo van a tener
  // completo desde el día uno.
  profile  FacilityProfile?
  weeklyLogEntries WeeklyLogEntry[]
  logEntries       FacilityLogEntry[]
  offerDeclarations FacilityOfferDeclaration[]

  @@unique([name, marketId])
  @@index([marketId])
  @@map("facilities")
}

enum GameStatus {
  CONFIRMED
  CANCELLED
}

// Categoría normalizada de motivo de cancelación. El CSV trae texto libre
// con 291 variantes distintas (con mayúsculas/espacios inconsistentes);
// esto es la versión limpia que usamos para generar insights confiables.
enum CancellationCategory {
  NOT_ENOUGH_PLAYERS
  FACILITY_UNAVAILABLE
  WEATHER
  MAINTENANCE
  HOLIDAY
  PLUGIN // cancelaciones hechas por agentes externos a Operaciones ("Cancelled due to plugin"); se excluyen de la demanda y de la planificación
  OTHER
}

model Game {
  id                    Int                   @id // "Game ID" del CSV, ya es único
  facilityId            String
  facility              Facility              @relation(fields: [facilityId], references: [id])
  organizer             String                // "Plei" | "2026 Summer of Soccer" | "Plei Video"
  date                  DateTime              @db.Date
  time                  String                // hora de inicio, formato "HH:MM"
  dayOfWeek             String
  minPlayers            Int
  maxPlayers            Int
  gameSize              String?               // "Game Size" del CSV — dato directo (ej "7v7"), reemplaza la inferencia por Max Players
  fieldType             String?               // extraído de "Field" — solo cuando el dato tiene especificidad real (tipo o nombre), null si es solo un identificador (ej "Field #1")
  // Identidad de la cancha dentro del facility ("Field 1", "Turf Field 2",
  // "Old Trafford"), extraída de la misma columna "Field" pero conservando el
  // identificador y sin el formato (el formato vive en gameSize). Con esto un
  // partido se identifica por facility + día + hora + fieldName + gameSize:
  // Cancha 1 6v6 y Cancha 3 6v6 a la misma hora son dos partidos distintos.
  // null cuando el CSV no trae identificador (~21% vacío, más filas que solo
  // dicen "6v6"). Ver scripts/lib/fieldName.ts.
  fieldName             String?
  finalPlayers          Int
  waitlistPlayers       Int
  droppedPlayers        Int
  status                GameStatus
  playersMissing        Int?
  cancellationReasonRaw String?               // texto original del CSV, para auditoría
  cancellationCategory  CancellationCategory?
  confirmationLeadTime  Float?                // horas entre confirmación y el partido
  eventRevenue          Float?
  gamePrice             Float?
  revenuePerPlayer      Float?
  ratingCount           Int?
  averageRating         Float?
  createdAt             DateTime              @default(now())
  // Reviews individuales (ver GameReview) — ratingCount/averageRating de
  // arriba siguen siendo la fuente de verdad del agregado; esto es el
  // detalle crudo (texto, tags, jugador) detrás de ese número.
  reviews               GameReview[]

  @@index([facilityId])
  @@index([date])
  @@index([status])
  // Compuestos: la mayoría de las consultas reales combinan estas columnas
  // juntas (rango de fecha + status, o facility + status/fecha) desde que
  // migramos a groupBy/aggregate — un índice compuesto sirve para ese patrón
  // completo, no solo para filtrar por una columna sola.
  @@index([date, status])
  @@index([facilityId, status])
  @@index([facilityId, date])
  @@index([facilityId, fieldName])
  @@map("games")
}

// ---------- Player Satisfaction (reviews) ----------
// Dos fuentes bien distintas, deliberadamente NO mezcladas en un solo
// modelo: GameReview es por partido/facility (del export de reviews del
// dashboard de Plei); AppReview es de las tiendas de apps (iOS/Android),
// sin ningún vínculo a facility o partido. Se muestran como dos pestañas
// de la misma sección de Leadership, no como una sola métrica combinada.
//
// Ninguno de los dos CSV trae un ID de review estable, así que en vez de
// un ID real se usa reviewKey: un hash de un subconjunto de columnas que
// identifican "la misma review" aunque el resto de sus datos cambie entre
// una exportación y la siguiente (v6, 25 sep 2026 — antes era hash de TODO
// el contenido de la fila, que solo servía para descartar duplicados
// exactos, nunca para detectar una edición). Con reviewKey como identidad:
// una fila cuyo reviewKey ya existe se trata como la MISMA review y
// actualiza sus campos "mutables" (ver cada modelo); una fila nueva se
// agrega; una fila existente que no aparece en la exportación actual (por
// ej. quedó afuera de un export incremental más chico) se deja como está.
// Este es el mismo criterio de upsert real que usa import-csv.ts para
// Game, adaptado a que acá no hay un ID de origen para apoyarse.

// Catálogo cerrado de tags del export de reviews por partido (9 valores
// reales al 25 sep 2026, ver mapa de campos en el Project). Dos variantes
// de tilde para "Wasn't/Wasn't Competitive" en el CSV de origen se
// normalizan a un solo valor en la importación.
enum GameReviewTag {
  FRIENDLY_PLAYERS
  COMPETITIVE_GAME
  NOT_COMPETITIVE
  GOOD_PLAYERS
  ISSUES_WITH_OTHER_PLAYERS
  FIELD_QUALITY_GREAT
  FIELD_QUALITY_GOOD
  FIELD_CONDITIONS_ISSUES
}

model GameReview {
  id     String        @id @default(cuid())
  gameId Int
  game   Game          @relation(fields: [gameId], references: [id])
  // Identidad (compone reviewKey junto con playerPhoneHash): gameId + date.
  date   DateTime      @db.Date
  // Mutable: se actualiza si una fila con el mismo reviewKey vuelve a
  // aparecer con otro valor (ej. la review se editó).
  rating Int
  tags   GameReviewTag[]
  reviewText String?
  // Nunca el número real (decisión de Ivan, 25 sep 2026): SHA-256 del
  // teléfono normalizado. Permite detectar al mismo jugador en varios
  // partidos (proxy de repeat booking) sin guardar ni mostrar PII. También
  // es parte de la identidad de reviewKey (ver abajo).
  playerPhoneHash String?
  // Identidad = hash(gameId + playerPhoneHash + date) — ver nota arriba del
  // bloque. NO incluye rating/tags/reviewText a propósito: esos son los
  // campos que se actualizan cuando la misma review vuelve a aparecer.
  reviewKey String @unique

  @@index([gameId])
  @@index([playerPhoneHash])
  @@map("game_reviews")
}

enum AppReviewSource {
  IOS
  ANDROID
}

model AppReview {
  id         String          @id @default(cuid())
  // Identidad (compone reviewKey): reviewDate + source.
  reviewDate DateTime
  source     AppReviewSource
  // Mutables: se actualizan si la misma review (mismo reviewKey) vuelve a
  // aparecer con otro valor — el caso real más común es que se le agregue
  // una respuesta después de que ya la habíamos importado.
  rating        Int
  reviewText    String?
  replyText     String?
  replyDate     DateTime?
  replied       Boolean         @default(false)
  replyTimeDays Float?
  // Identidad = hash(reviewDate + source) — ver nota arriba del bloque.
  reviewKey String @unique

  @@map("app_reviews")
}

// Rol de cuenta. Simple a propósito: hoy solo distingue quién puede
// administrar usuarios (ADMIN) del resto (MEMBER). Deliberadamente NO se usa
// para modelar "acceso a leadership" (ver canViewLeadership abajo): son dos
// preguntas distintas — quién administra usuarios vs. quién ve data
// estratégica — y no siempre coinciden (un admin técnico no necesariamente
// es leadership, y viceversa). Este enum queda como el punto de extensión
// si en el futuro aparecen roles de administración genuinamente distintos.
enum Role {
  ADMIN
  MEMBER
}

// Módulos de la app. Cada uno agrupa rutas y tiene su propio permiso por
// usuario (ver UserModuleAccess). El registro en código — rutas, página de
// inicio y nivel por defecto — vive en app/lib/module.ts.
//   MAGIC     Operativo: Resumen, Rendimiento, Mercado y el reporte operativo.
//   TEAM      Equipo: lo que el equipo carga a mano (Registro semanal; después
//             la Bitácora de Facilities).
//   EXECUTIVE Ejecutivo: /panel-ejecutivo y el Executive Summary.
// Ver también User.lastModule.
enum AppModule {
  MAGIC
  EXECUTIVE
  TEAM
}

// Nivel de acceso a un módulo. VIEW = ver; EDIT = además cargar/editar los
// datos manuales del módulo (notas del registro, Facility Profile).
// Administrar usuarios NO es un nivel de módulo: sigue siendo Role.ADMIN.
enum ModuleLevel {
  NONE
  VIEW
  EDIT
}

// Acceso de un usuario a un módulo. Sin fila = el nivel por defecto del
// módulo (app/lib/module.ts), así una cuenta nueva entra con los defaults
// sin que haya que crearle filas. Una fila con NONE quita un acceso que por
// defecto tendría.
model UserModuleAccess {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    AppModule
  level     ModuleLevel
  updatedAt DateTime    @updatedAt

  @@id([userId, module])
  @@map("user_module_access")
}

// Cuenta de la app. NextAuth sigue en JWT puro (sin adapter/DB sessions) —
// esta tabla no reemplaza esa sesión, es el registro de negocio asociado
// a cada email. Se crea/actualiza sola en el callback signIn (ver
// app/lib/auth.ts): no hay alta manual, el primer login de un email
// autorizado (dominio de Google Workspace) ya crea la fila. El rol inicial
// sale de ADMIN_EMAILS (variable de entorno, solo importa en el primer
// login de cada cuenta); a partir de ahí, los cambios de rol se hacen desde
// /admin/users, no editando esa variable.
// ---------- Facility Profile (módulo de datos maestros) ----------
// Datos manuales sobre cada facility que no vienen del CSV de partidos:
// atributos físicos, términos de la relación comercial, y una bitácora de
// eventos. Módulo aparte, enlazado desde /leadership (mismo gate que
// canViewLeadership en v1 — ver requireLeadershipAccess). Nace del gap
// analysis de Leadership Metrics (ver el mapa de campos en el Project);
// casi todo es opcional porque se va completando de a poco, no de una vez.

enum IndoorOutdoor {
  INDOOR
  OUTDOOR
  MIXED
}

// Catálogo cerrado de amenities + un campo de texto libre para lo que no
// entra en el catálogo (decisión de Ivan: las dos cosas, no solo una).
// Lista inicial, ampliable con el tiempo sin romper nada existente.
enum Amenity {
  PARKING
  LOCKER_ROOMS
  SHOWERS
  CAFETERIA_BAR
  WIFI
  PRO_SHOP
  SPECTATOR_SEATING
  AIR_CONDITIONING
  FIRST_AID
  SECURITY_CAMERAS
  NIGHT_LIGHTING
}

// Decisión de Ivan: enum + campos tipados, no texto libre — Leadership
// quiere comparar economics entre facilities y un modelo de texto libre no
// es agregable en reportes.
enum PricingModel {
  FIXED_RATE
  REVENUE_SHARE
  HYBRID
}

// Unidad en la que se expresa FacilityProfile.fixedRate (antes era un número
// sin unidad: $100 la hora y $8 por jugador no son comparables).
// Qué tan precisa es la coordenada de un facility: ADDRESS = a nivel calle/
// número, POSTAL_CODE = centro aproximado del ZIP/ciudad (dirección no
// resoluble, ej. plus-codes), MANUAL = cargada a mano (el script de
// geocodificación no la pisa).
enum GeoPrecision {
  ADDRESS
  POSTAL_CODE
  MANUAL
}

enum RateUnit {
  PER_HOUR
  PER_PLAYER
  FLAT_FEE
}

model FacilityProfile {
  id         String   @id @default(cuid())
  facilityId String   @unique
  facility   Facility @relation(fields: [facilityId], references: [id])

  // --- Datos básicos ---
  city             String?
  state            String?
  fieldCount       Int?
  // Formatos que el facility puede albergar (ej. "7v7", "11v11"). Texto
  // libre, no enum: el resto de la app tampoco tiene un catálogo cerrado
  // para esto (gameSize/fieldType en Game son String? de origen CSV), así
  // que se mantiene el mismo criterio en vez de inventar uno nuevo acá.
  supportedFormats String[]
  indoorOutdoor    IndoorOutdoor?
  amenities        Amenity[]
  amenitiesOther   String?
  // = "Published Rate(s)" (Facility Profile) = "Market rate" (Commercial
  // Terms) en el PDF de Leadership: es el mismo dato mirado desde dos
  // categorías distintas, se modela una sola vez.
  marketRate       Float?

  // --- Relación (Relationship Attributes) ---
  partnershipStartDate DateTime? @db.Date
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  // Texto libre v1 (decisión de Ivan) — sin contratos reales cargados
  // todavía, estructurar esto ahora sería adivinar una forma. Candidato a
  // volverse campos estructurados más adelante si aparecen patrones claros.
  paymentTerms      String?
  bookingTerms      String?
  cancellationTerms String?
  depositAmount     Float?
  depositNotes      String?

  // --- Comercial (depende de pricingModel) ---
  pricingModel      PricingModel?
  fixedRate         Float? // aplica si FIXED_RATE o HYBRID
  revenueSharePct   Float? // aplica si REVENUE_SHARE o HYBRID
  discountAmount    Float?
  discountPct       Float?
  freeHoursPerMonth Float?
  rateUnit          RateUnit? // unidad de fixedRate

  // --- Origen Sheet (Airtable) ---
  // Texto de tarifas tal como vino del Sheet, sin tocar: puede traer notas,
  // varias tarifas (peak/off-peak, por cancha) o estar desactualizado. Los
  // campos tipados de arriba se completan solo cuando el texto es
  // inequívoco; lo demás se corrige a mano desde la UI.
  pricingRawText    String?
  // Se completa cuando alguien con permiso edita/confirma las tarifas en la
  // UI: distingue "dato del Sheet, posiblemente viejo" de "dato verificado".
  ratesVerifiedAt   DateTime?
  address           String?
  postalCode        String?
  website           String?
  // Tipos del Sheet ("Private Soccer Facility", "Organizer/Host"...), puede
  // haber más de uno por facility. Distinto del Market (que es geográfico).
  facilityTypes     String[]
  // "Active facility" del Sheet (checked = true). Es el estado comercial
  // declarado a mano; no se confunde con activeFacilityWhere (actividad real).
  isActive          Boolean?

  // --- Ubicación (scripts/geocode-facilities.ts) ---
  latitude          Float?
  longitude         Float?
  geoPrecision      GeoPrecision?
  geocodedAt        DateTime?

  peakWindows FacilityPeakWindow[]
  events      FacilityRelationshipEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("facility_profiles")
}

// Decisión de Ivan: peak hours manual por facility (no una regla de red
// única ni calculado desde demanda histórica). Un facility puede tener
// varias ventanas recurrentes semanales (ej. lun-vie 17-22h Y todo el
// fin de semana) — de ahí que sea una tabla y no un par de campos sueltos.
model FacilityPeakWindow {
  id                String          @id @default(cuid())
  facilityProfileId String
  facilityProfile   FacilityProfile @relation(fields: [facilityProfileId], references: [id], onDelete: Cascade)
  dayOfWeek         Int // 0=domingo … 6=sábado
  startHour         Int // 0–23
  endHour           Int // 1–24 (exclusivo)

  @@index([facilityProfileId])
  @@map("facility_peak_windows")
}

enum RelationshipEventType {
  EVENT // Major relationship event — bitácora libre
  AGREEMENT // Facility Partnership Agreement — con archivo adjunto
  ACTION_ITEM // Open action item — con estado abierto/cerrado
}

enum RelationshipEventStatus {
  OPEN
  CLOSED
}

// Resuelve 3 campos de Relationship History que estaban pendientes de
// definición sin necesidad de esperar la feature de Notas (que sigue
// pausada): una bitácora simple por facility, con un tipo para distinguir
// evento / acuerdo / pendiente de acción.
model FacilityRelationshipEvent {
  id                String                   @id @default(cuid())
  facilityProfileId String
  facilityProfile   FacilityProfile          @relation(fields: [facilityProfileId], references: [id], onDelete: Cascade)
  type              RelationshipEventType
  date              DateTime                 @db.Date
  note              String
  status            RelationshipEventStatus? // solo aplica a ACTION_ITEM
  attachmentUrl     String? // solo aplica a AGREEMENT
  // Sin relación formal a User a propósito — es solo un dato de auditoría
  // liviano, no necesita el vínculo/cascade de una relación Prisma.
  createdByUserId   String?
  createdAt         DateTime                 @default(now())

  @@index([facilityProfileId])
  @@index([facilityProfileId, type])
  @@map("facility_relationship_events")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  image       String?
  role        Role      @default(MEMBER)
  // OBSOLETO desde la migración 20261016120000_module_access: el acceso a
  // Ejecutivo ahora es UserModuleAccess (module EXECUTIVE). Esa migración copió
  // este valor (true -> EDIT) y la app ya no lo lee ni lo escribe: es un dato
  // congelado, NO un permiso vigente. La columna se conserva a propósito (por
  // si sirve como referencia histórica); se declara acá para que el esquema y
  // la base coincidan y prisma migrate dev no proponga borrarla.
  canViewLeadership Boolean @default(false)
  // Opt-out (default true) del mail semanal de reportes (Ops para
  // cualquier cuenta activa, Executive Summary además solo para quienes
  // tienen Ejecutivo >= Ver) — se administra desde /admin/users, con el
  // criterio de "un solo booleano por fila, sin paso de confirmar" (ver UserRoleTable).
  receivesWeeklyReport Boolean @default(true)
  // Reemplaza a la vieja UserPreference: mismo dato (idioma elegido), ahora
  // en la misma fila que el resto de la cuenta en vez de una tabla aparte
  // keyed por el mismo email.
  locale      String    @default("es")
  // Último módulo que el usuario visitó (Magic u Executive) — mismo criterio
  // que locale: persiste en la cuenta para que viaje entre dispositivos, y
  // hay una cookie en paralelo (ver app/lib/actions/module.ts) para que
  // funcione en el primer request de una sesión nueva sin esperar la
  // consulta a esta fila. Default MAGIC porque es lo que cualquier cuenta
  // nueva (sin acceso a Ejecutivo) ve hoy — el valor es irrelevante
  // para quien nunca tiene acceso a Executive.
  lastModule  AppModule @default(MAGIC)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  weeklyLogEntries WeeklyLogEntry[]
  moduleAccess     UserModuleAccess[]
  logEntries       FacilityLogEntry[]
  logReactions     FacilityLogReaction[]
  logReplies       FacilityLogReply[]
  offerDeclarations FacilityOfferDeclaration[]

  @@map("users")
}

// ---------- Registro semanal ----------
// Notas sueltas que el equipo va anotando durante la semana (viernes a
// jueves) y que después se juntan en un reporte para el manager. Lo ve todo
// el equipo; cada persona edita y borra solo lo suyo. `topic` es texto libre
// ("Soccer City", "POC Acme", "Pagos"); cuando coincide con el nombre de una
// facility se guarda además `facilityId`, para poder cruzar las notas con los
// datos de esa facility sin depender de cómo se escribió el nombre.
model WeeklyLogEntry {
  id         String    @id @default(cuid())
  date       DateTime  @db.Date // día al que se refiere la nota (no cuándo se cargó)
  text       String
  topic      String?
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([date])
  @@index([facilityId])
  @@map("weekly_log_entries")
}

// ---------- Bitácora de Facilities ----------
// Lo que el equipo va registrando sobre la relación con cada facility. Se registran HECHOS, no etiquetas:
// "conflictivo" o "fiable" no se cargan, se derivan más adelante (Fase 2) de estos aportes. Modelo conceptual:
// docs del proyecto "Facility Relationship Tracking". Reemplaza a FacilityRelationshipEvent (quedó con sus filas
// copiadas, ver la migración; la tabla vieja ya no se escribe).
//
// Tres tipos de aporte (`kind`): Evento (algo que pasó, con catálogo de tipos), Observación (tema + valoración)
// e Insight (qué esperar / cómo trabajar con ellos / qué mejorar). Los catálogos de subtipos y resoluciones viven en
// código (app/lib/facilityLog.ts), no como enums, para poder ajustarlos sin migrar; el tipo de evento sí es enum
// porque el cálculo del estado se apoya en él.
enum FacilityLogKind {
  EVENT
  OBSERVATION
  INSIGHT
}

enum FacilityEventType {
  RETIRO_SLOT // la facility pide cancelar o mover un partido ya publicado
  LIBERACION_TARDIA // retiene disponibilidad hasta último momento
  OFERTA_RESIDUAL // solo ofrece sobrantes
  PEDIDO // pide algo (publicar todo, más partidos, cambio de horario, precio)
  TRATO_INADECUADO
  SIN_RESPUESTA
  POSITIVO
  QUEJA_JUGADOR
  INCUMPLIMIENTO_PLEI // incumplimiento nuestro
}

enum FacilityLogTone {
  CORDIAL
  TENSE
  HOSTILE
}

enum FacilityLogSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FacilityInsightKind {
  EXPECT // qué esperar
  HOW_TO_WORK // cómo trabajar con ellos
  IMPROVE // qué mejorar
}

model FacilityLogEntry {
  id         String          @id @default(cuid())
  facilityId String
  facility   Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  // Nullable: las filas migradas desde FacilityRelationshipEvent pueden no tener autor conocido, y si se borra la
  // cuenta de quien escribió, el aporte se conserva.
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind       FacilityLogKind
  occurredAt DateTime        @db.Date // día en que pasó (no cuándo se cargó)
  text       String

  // --- EVENT ---
  eventType           FacilityEventType?
  subtype             String? // catálogo según el tipo (app/lib/facilityLog.ts)
  tone                FacilityLogTone?
  resolution          String? // solo PEDIDO
  usedData            Boolean? // solo PEDIDO rechazado: ¿argumentamos con datos?
  committedSlot       Boolean? // solo RETIRO_SLOT: ¿el slot era un compromiso?
  hours               Int? // RETIRO_SLOT / LIBERACION_TARDIA: anticipación del aviso; SIN_RESPUESTA: horas sin respuesta
  hoursSincePublished Int? // solo RETIRO_SLOT
  playersSigned       Int? // jugadores anotados al momento del hecho
  severity            Int? // solo TRATO_INADECUADO, 1 a 3
  gameId              Int? // partido afectado, si lo hay (sin FK: puede no estar importado)

  // --- OBSERVATION ---
  topic     String?
  sentiment FacilityLogSentiment?

  // --- INSIGHT ---
  insightKind FacilityInsightKind?

  evidenceUrl String?
  // Id de la fila de FacilityRelationshipEvent de la que se copió (null en aportes nuevos).
  legacyId    String? @unique

  reactions FacilityLogReaction[]
  replies   FacilityLogReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId, occurredAt])
  @@index([occurredAt])
  @@map("facility_log_entries")
}

// "Coincido" / "No coincido" sobre el aporte de otra persona: una reacción por persona y aporte.
model FacilityLogReaction {
  entryId String
  entry   FacilityLogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agrees  Boolean
  createdAt DateTime       @default(now())

  @@id([entryId, userId])
  @@map("facility_log_reactions")
}

model FacilityLogReply {
  id        String           @id @default(cuid())
  entryId   String
  entry     FacilityLogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime         @default(now())

  @@index([entryId, createdAt])
  @@map("facility_log_replies")
}

// Modalidad de oferta que la facility DICE dar (ver "Bitácora de Facilities"): bloqueada y recurrente / recurrente no
// bloqueada / diaria variable / solo residual. Se compara contra lo que efectivamente publica (recurrencia de slots).
enum FacilityOfferModality {
  BLOCKED_RECURRING
  RECURRING
  DAILY_VARIABLE
  RESIDUAL_ONLY
}

// Cada cambio es una fila nueva (quién, cuándo, valor, nota): no se pisa el anterior, así queda el historial. La
// vigente es la más reciente. Si dos personas declaran valores distintos en 60 días, la ficha lo marca para revisar.
model FacilityOfferDeclaration {
  id              String                @id @default(cuid())
  facilityId      String
  facility        Facility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  modality        FacilityOfferModality
  // ¿Hay otros organizadores compitiendo por el mismo inventario? null = no se sabe.
  otherOrganizers Boolean?
  note            String?
  createdAt       DateTime              @default(now())

  @@index([facilityId, createdAt])
  @@map("facility_offer_declarations")
}
